filters:
  and:
    - 'file.inFolder("notes")'
    - 'file.ext == "md"'
    - or:
        - 'note.kind == "opportunity"'
        - 'note.kind == "rfp"'
        - 'note.kind == "workshop"'
        - 'note.kind == "functional-design"'
        - 'note.kind == "decision"'
        - 'note.kind == "handover"'
        - 'note.kind == "debrief"'
        - 'note.kind == "closeout"'
        - 'note.kind == "question"'
        - 'note.kind == "action"'
properties:
  note.owner:
    displayName: Accountable role
  note.status:
    displayName: Working status
  note.disposition:
    displayName: Requested response
  note.due:
    displayName: Agreed date
views:
  - type: table
    name: Open work
    filters:
      and:
        - 'note.status != "closed"'
        - 'note.status != "superseded"'
    order:
      - file.name
      - note.kind
      - note.disposition
      - note.owner
      - note.status
      - note.due
    columnSize:
      note.kind: 160
  - type: table
    name: All working notes
    order:
      - file.name
      - note.kind
      - note.owner
      - note.status
      - note.due
    columnSize:
      note.kind: 160
